# 1. Берем официальный образ Python (облегченную версию)
FROM python:3.12-slim

# 2. Создаем рабочую папку внутри контейнера
WORKDIR /app

# 3. Копируем все файлы из нашей папки app в контейнер
COPY . .

# 4. Устанавливаем Flask внутри контейнера
RUN python -m pip install Flask

# 5. Открываем порт 5000 (на котором работает Flask)
EXPOSE 5000

# 6. Команда, которая запустит наше приложение при старте контейнера
CMD ["python", "app.py"]
