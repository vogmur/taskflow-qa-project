            "exec": [
              "// 1. Генерируем уникальное название: слово \"ЗАДАЧА_\" + текущее время в миллисекундах\r\nconst uniqueTitle = \"Задача_\" + Date.now();\r\n\r\n// 2. Сохраняем это название в переменную окружения под именем dynamicTitle\r\npm.environment.set(\"dynamicTitle\", uniqueTitle);\r\n\r\n// 3. Выводим результат в консоль, чтобы мы могли увидеть, что получилось\r\nconsole.log(\"Сгенерированно: \" + uniqueTitle);"
            ]
